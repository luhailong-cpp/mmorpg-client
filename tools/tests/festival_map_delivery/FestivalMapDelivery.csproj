<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <Nullable>disable</Nullable>
    <!-- DTO fields are populated by the JSON adapter. Local I/O facades replace only native resource APIs. -->
    <NoWarn>$(NoWarn);CS0649;CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="NativeApiAdapters.cs" />
    <Compile Include="../../../Assets/Scripts/World/CurrentMaps/MapDeliveryContract.cs" Link="Production/MapDeliveryContract.cs" />
    <Compile Include="../../../Assets/Scripts/World/CurrentMaps/CurrentMapCatalog.cs" Link="Production/CurrentMapCatalog.cs" />
    <Compile Include="../../../Assets/Scripts/World/CurrentMaps/CurrentMapTilesManifest.cs" Link="Production/CurrentMapTilesManifest.cs" />
    <Compile Include="../../../Assets/Scripts/World/Tianyong/CityTileManifest.cs" Link="Production/CityTileManifest.cs" />
    <Compile Include="../../../Assets/Scripts/World/Tianyong/TianyongNavigationGrid.cs" Link="Production/TianyongNavigationGrid.cs" />
    <Compile Include="../../../Assets/Scripts/World/Tianyong/TianyongMapDefinition.cs" Link="Production/TianyongMapDefinition.cs" />
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityManagedPath)/UnityEngine.CoreModule.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireUnityManagedGeometry" BeforeTargets="ResolveReferences" Condition="!Exists('$(UnityManagedPath)/UnityEngine.CoreModule.dll')">
    <Error Text="Pass -p:UnityManagedPath=&lt;Unity Editor Data/Managed/UnityEngine&gt;. Real managed geometry is required." />
  </Target>
</Project>
