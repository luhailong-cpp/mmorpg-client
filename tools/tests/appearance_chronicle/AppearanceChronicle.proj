<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../../.codex-artifacts/appearance-chronicle-20261123/current-tests/obj/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)../../../.codex-artifacts/appearance-chronicle-20261123/current-tests/bin/</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LanguageTargets>$(MSBuildToolsPath)/Microsoft.CSharp.targets</LanguageTargets>
  </PropertyGroup>
  <Target Name="CheckUnityManagedReference" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(UnityManagedDir)/UnityEngine.CoreModule.dll')" Text="Pass -p:UnityManagedDir=PATH_TO_UNITY_Editor_Data_Managed_UnityEngine. This console check never launches Unity." />
  </Target>
  <ItemGroup>
    <Reference Include="Google.Protobuf"><HintPath>../../../Assets/Plugins/Google.Protobuf.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityManagedDir)/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Compile Include="Program.cs" />
    <Compile Include="../../../Assets/Scripts/Game/Appearance/AppearanceClient.cs" Link="Production/AppearanceClient.cs" />
    <Compile Include="../../../Assets/Scripts/Game/Appearance/AppearanceBiography.cs" Link="Production/AppearanceBiography.cs" />
    <Compile Include="../../../Assets/Scripts/Game/Battle/IBattleTransport.cs" Link="Production/IBattleTransport.cs" />
    <Compile Include="../../../Assets/Scripts/Net/ClientRequestKeys.cs" Link="Production/ClientRequestKeys.cs" />
    <Compile Include="../../../Assets/Scripts/Net/OutstandingCalls.cs" Link="Production/OutstandingCalls.cs" />
    <Compile Include="../../../Assets/Scripts/Net/RpcStatus.cs" Link="Production/RpcStatus.cs" />
    <Compile Include="../../../Assets/Scripts/Net/MessageIds.cs" Link="Production/MessageIds.cs" />
    <Compile Include="../../../Assets/Scripts/Proto/Generated/PlayerAppearance.cs" Link="Generated/PlayerAppearance.cs" />
    <Compile Include="../../../Assets/Scripts/Proto/Generated/AppearanceErrorTip.cs" Link="Generated/AppearanceErrorTip.cs" />
    <Compile Include="../../../Assets/Scripts/Proto/Generated/CommonErrorTip.cs" Link="Generated/CommonErrorTip.cs" />
    <Compile Include="../../../Assets/Scripts/Proto/Generated/ProtoOption.cs" Link="Generated/ProtoOption.cs" />
    <Compile Include="../../../Assets/Scripts/Proto/Generated/Tip.cs" Link="Generated/Tip.cs" />
    <Compile Include="../../../Assets/Scripts/Proto/Generated/Empty.cs" Link="Generated/Empty.cs" />
    <Compile Include="../../../Assets/Scripts/Proto/Generated/Message.cs" Link="Generated/Message.cs" />
    <Compile Include="../../../Assets/Scripts/Proto/Generated/Common.cs" Link="Generated/Common.cs" />
    <Compile Include="../../../Assets/Scripts/Proto/Generated/Session.cs" Link="Generated/Session.cs" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
